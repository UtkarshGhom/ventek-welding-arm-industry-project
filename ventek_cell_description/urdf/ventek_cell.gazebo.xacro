<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <!-- ======================================================================== -->
  <!-- Gazebo Sim (Harmonic) Controllers, Visual Aesthetics & Materials         -->
  <!-- ======================================================================== -->

  <!-- Built-in Gazebo Sim Joint Position Controllers for Synchronized Motion -->
  <gazebo>
    <!-- Joint 1 (Base Rotation - 600kg assembly) -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint_1</joint_name>
      <topic>/model/ventek_spot_welding_cell/joint/joint_1/cmd_pos</topic>
      <p_gain>35000.0</p_gain>
      <d_gain>4500.0</d_gain>
      <i_gain>0.0</i_gain>
      <cmd_max>25000.0</cmd_max>
      <cmd_min>-25000.0</cmd_min>
    </plugin>

    <!-- Joint 2 (Shoulder Pitch - heavy lifting against gravity) -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint_2</joint_name>
      <topic>/model/ventek_spot_welding_cell/joint/joint_2/cmd_pos</topic>
      <p_gain>45000.0</p_gain>
      <d_gain>5500.0</d_gain>
      <i_gain>0.0</i_gain>
      <cmd_max>30000.0</cmd_max>
      <cmd_min>-30000.0</cmd_min>
    </plugin>

    <!-- Joint 3 (Elbow Pitch) -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint_3</joint_name>
      <topic>/model/ventek_spot_welding_cell/joint/joint_3/cmd_pos</topic>
      <p_gain>30000.0</p_gain>
      <d_gain>4000.0</d_gain>
      <i_gain>0.0</i_gain>
      <cmd_max>22000.0</cmd_max>
      <cmd_min>-22000.0</cmd_min>
    </plugin>

    <!-- Joint 4 (Forearm Roll) -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint_4</joint_name>
      <topic>/model/ventek_spot_welding_cell/joint/joint_4/cmd_pos</topic>
      <p_gain>12000.0</p_gain>
      <d_gain>1500.0</d_gain>
      <i_gain>0.0</i_gain>
      <cmd_max>10000.0</cmd_max>
      <cmd_min>-10000.0</cmd_min>
    </plugin>

    <!-- Joint 5 (Wrist Pitch) -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint_5</joint_name>
      <topic>/model/ventek_spot_welding_cell/joint/joint_5/cmd_pos</topic>
      <p_gain>8000.0</p_gain>
      <d_gain>1000.0</d_gain>
      <i_gain>0.0</i_gain>
      <cmd_max>8000.0</cmd_max>
      <cmd_min>-8000.0</cmd_min>
    </plugin>

    <!-- Joint 6 (Wrist Roll) -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint_6</joint_name>
      <topic>/model/ventek_spot_welding_cell/joint/joint_6/cmd_pos</topic>
      <p_gain>4500.0</p_gain>
      <d_gain>500.0</d_gain>
      <i_gain>0.0</i_gain>
      <cmd_max>5000.0</cmd_max>
      <cmd_min>-5000.0</cmd_min>
    </plugin>

    <!-- Cell Sliding Door -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>cell_door_joint</joint_name>
      <topic>/model/ventek_spot_welding_cell/joint/cell_door_joint/cmd_pos</topic>
      <p_gain>5000.0</p_gain>
      <d_gain>400.0</d_gain>
      <cmd_max>2000.0</cmd_max>
      <cmd_min>-2000.0</cmd_min>
    </plugin>

    <!-- Joint State Publisher for Simulated Joints -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states_gz</topic>
    </plugin>
  </gazebo>

