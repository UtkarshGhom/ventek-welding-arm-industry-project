<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <!-- ======================================================================== -->
  <!-- Intel RealSense D435 RGB-D Eye-in-Hand Camera Macro                     -->
  <!-- Scaled Standoff Bracket, Optimized POV Aimed Directly at Fixture Setup  -->
  <!-- ======================================================================== -->

  <xacro:macro name="realsense_d435" params="prefix parent *origin scale:=0.75">

    <xacro:property name="cam_scale" value="${scale}"/>

    <!-- Materials -->
    <material name="${prefix}camera_aluminum">
      <color rgba="0.82 0.82 0.85 1.0"/>
    </material>
    <material name="${prefix}camera_lens_dark">
      <color rgba="0.08 0.08 0.10 1.0"/>
    </material>
    <material name="${prefix}intel_blue">
      <color rgba="0.0 0.44 0.73 1.0"/>
    </material>
    <material name="${prefix}carbon_bracket">
      <color rgba="0.18 0.18 0.20 1.0"/>
    </material>

    <!-- 1. Standoff Mount Joint (Attached to Robot Tool0 Flange) -->
    <joint name="${prefix}tool0_to_camera_mount" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${prefix}camera_mount_bracket"/>
    </joint>

    <!-- Standoff Bracket: Rigid Carbon Fiber Extension Arm Outward from Gun -->
    <link name="${prefix}camera_mount_bracket">
      <visual>
        <!-- Horizontal base extension -->
        <origin xyz="0.09 0.08 0.02" rpy="0 0.5 0.785"/>
        <geometry>
          <box size="0.21 0.035 0.035"/>
        </geometry>
        <material name="${prefix}carbon_bracket"/>
      </visual>
      <visual>
        <!-- Forward strut pointing towards the camera position past the gun body -->
        <origin xyz="0.15 0.15 0.38" rpy="0.28 -0.28 0"/>
        <geometry>
          <cylinder length="0.76" radius="0.012"/>
        </geometry>
        <material name="${prefix}carbon_bracket"/>
      </visual>
      <collision>
        <origin xyz="0.15 0.15 0.38" rpy="0.28 -0.28 0"/>
        <geometry>
          <cylinder length="0.76" radius="0.015"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.15 0.14 0.36" rpy="0 0 0"/>
        <mass value="0.50"/>
        <inertia ixx="0.03" ixy="0.0" ixz="0.0" iyy="0.03" iyz="0.0" izz="0.005"/>
      </inertial>
    </link>

    <!-- Positioned forward at Z=0.76m, offset X=0.22, Y=0.22, optical axis aimed directly at fixture setup with zero gun occlusion -->
    <joint name="${prefix}bracket_to_camera_link" type="fixed">
      <origin xyz="0.22 0.22 0.76" rpy="2.08 -0.81 -2.23"/>
      <parent link="${prefix}camera_mount_bracket"/>
      <child link="${prefix}camera_link"/>
    </joint>

    <!-- Camera Physical Body (Intel RealSense D435) -->
    <link name="${prefix}camera_link">
      <!-- Silver Aluminum Chassis -->
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.025 0.090 0.025"/>
        </geometry>
        <material name="${prefix}camera_aluminum"/>
      </visual>
      <!-- Front Optical Glass Band -->
      <visual>
        <origin xyz="0.013 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.002 0.086 0.021"/>
        </geometry>
        <material name="${prefix}camera_lens_dark"/>
      </visual>
      <!-- Intel Blue Accent Stripe -->
      <visual>
        <origin xyz="0.013 0.035 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.003 0.012 0.018"/>
        </geometry>
        <material name="${prefix}intel_blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.028 0.095 0.028"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.072"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
      </inertial>
    </link>

    <!-- 3. Standard ROS Optical Frames (Z-forward, X-right, Y-down) -->
    <joint name="${prefix}camera_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="${-pi/2.0} 0 ${-pi/2.0}"/>
      <parent link="${prefix}camera_link"/>
      <child link="${prefix}camera_optical_frame"/>
    </joint>
    <link name="${prefix}camera_optical_frame"/>

    <!-- Alias matching Gazebo Sim auto-generated frame_id for TF compatibility in RViz -->
    <link name="${prefix}ventek_spot_welding_cell/link_6/realsense_d435"/>
    <joint name="${prefix}gz_realsense_frame_alias_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${prefix}camera_link"/>
      <child link="${prefix}ventek_spot_welding_cell/link_6/realsense_d435"/>
    </joint>

    <!-- ======================================================================== -->
    <!-- Gazebo Sim Sensor Definition (RGBD Camera)                               -->
    <!-- ======================================================================== -->
    <gazebo reference="${prefix}camera_link">
      <sensor name="realsense_d435" type="rgbd_camera">
        <always_on>true</always_on>
        <update_rate>30.0</update_rate>
        <visualize>true</visualize>
        <topic>/realsense</topic>
        <camera name="realsense_d435_rgbd">
          <horizontal_fov>1.5184</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.15</near>
            <far>6.0</far>
          </clip>
          <depth_camera>
            <clip>
              <near>0.15</near>
              <far>5.0</far>
            </clip>
          </depth_camera>
        </camera>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>
