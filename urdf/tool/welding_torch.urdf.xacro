<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <!-- ======================================================================== -->
  <!-- VENTEK Industrial Swan-Neck MIG Welding Torch Description                -->
  <!-- Accurate TCP (welding_torch_tip & tcp_welding_torch)                     -->
  <!-- ======================================================================== -->

  <xacro:macro name="welding_torch" params="prefix:='' parent:='tool0' *origin">

    <joint name="${prefix}welding_torch_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${prefix}welding_torch_link"/>
    </joint>

    <link name="${prefix}welding_torch_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://ventek_autonomous_welding/simulation/tool/meshes/welding_torch.dae"/>
        </geometry>
        <material name="torch_brass">
          <color rgba="0.88 0.55 0.18 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://ventek_autonomous_welding/simulation/tool/meshes/welding_torch.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="2.2"/>
        <origin xyz="0.04 0.0 0.12" rpy="0 0 0"/>
        <inertia ixx="0.015" ixy="0.0" ixz="0.0" iyy="0.018" iyz="0.0" izz="0.008"/>
      </inertial>
    </link>

    <!-- Gazebo Shading Material for Welding Torch -->
    <gazebo reference="${prefix}welding_torch_link">
      <visual>
        <material>
          <ambient>0.60 0.35 0.10 1.0</ambient>
          <diffuse>0.88 0.55 0.18 1.0</diffuse>
          <specular>0.70 0.55 0.30 1.0</specular>
        </material>
      </visual>
    </gazebo>

    <!-- Tool Centre Point (TCP) Definition -->
    <!-- Matches system_config.yaml (welding_torch_tip) -->
    <link name="${prefix}welding_torch_tip"/>
    <joint name="${prefix}welding_torch_tip_joint" type="fixed">
      <origin xyz="0.1344 0.0 0.2574" rpy="0 0.785398 0"/>
      <parent link="${prefix}welding_torch_link"/>
      <child link="${prefix}welding_torch_tip"/>
    </joint>

    <!-- Alias matching simulation plan (tcp_welding_torch) -->
    <link name="${prefix}tcp_welding_torch"/>
    <joint name="${prefix}tcp_welding_torch_alias" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${prefix}welding_torch_tip"/>
      <child link="${prefix}tcp_welding_torch"/>
    </joint>

    <!-- ======================================================================== -->
    <!-- Eye-in-Hand OAK-D Lite Depth Camera (Mounted on Welding Torch / Arm)     -->
    <!-- POV directly tracks the welding torch tip and joint seam in real time   -->
    <!-- ======================================================================== -->
    <link name="${prefix}camera_link">
      <visual>
        <!-- Rotate -90 deg around Z so the 3D model lenses (+Y) point along camera optical axis (+X) -->
        <origin xyz="0 0 0" rpy="0 0 -1.570796"/>
        <geometry>
          <mesh filename="package://ventek_autonomous_welding/simulation/cell/meshes/camera_oak_d_lite.dae"/>
        </geometry>
        <material name="camera_anodized_black">
          <color rgba="0.10 0.10 0.12 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.030 0.095 0.030"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.15"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <!-- Camera mounted on torch bracket: elevated above torch neck, looking at weld seam & nozzle -->
    <joint name="${prefix}camera_joint" type="fixed">
      <origin xyz="-0.04 0.0 0.14" rpy="0 0.82 0"/>
      <parent link="${prefix}welding_torch_link"/>
      <child link="${prefix}camera_link"/>
    </joint>

    <link name="${prefix}camera_optical_frame"/>
    <joint name="${prefix}camera_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="-1.570796 0 -1.570796"/>
      <parent link="${prefix}camera_link"/>
      <child link="${prefix}camera_optical_frame"/>
    </joint>

    <!-- Alias matching simulation plan (camera_frame) -->
    <link name="${prefix}camera_frame"/>
    <joint name="${prefix}camera_frame_alias" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${prefix}camera_link"/>
      <child link="${prefix}camera_frame"/>
    </joint>

    <!-- Alias matching Gazebo Sim frame_ids for seamless RViz PointCloud2 & Camera displays -->
    <link name="${prefix}oak_d_lite_sensor_model/camera_sensor_link/oak_d_lite_camera"/>
    <joint name="${prefix}gz_sensor_frame_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${prefix}camera_link"/>
      <child link="${prefix}oak_d_lite_sensor_model/camera_sensor_link/oak_d_lite_camera"/>
    </joint>

    <link name="${prefix}ventek_welding_cell/camera_link/oak_d_lite_camera"/>
    <joint name="${prefix}gz_sensor_cell_frame_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${prefix}camera_link"/>
      <child link="${prefix}ventek_welding_cell/camera_link/oak_d_lite_camera"/>
    </joint>

    <!-- Gazebo Shading & Moving Eye-in-Hand RGB-D Camera Sensor -->
    <gazebo reference="${prefix}camera_link">
      <visual>
        <material>
          <ambient>0.06 0.06 0.08 1.0</ambient>
          <diffuse>0.10 0.10 0.12 1.0</diffuse>
          <specular>0.20 0.20 0.20 1.0</specular>
        </material>
      </visual>
      <sensor name="oak_d_lite_camera" type="rgbd_camera">
        <camera>
          <horizontal_fov>1.204</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>4.0</far>
          </clip>
          <depth_camera>
            <clip>
              <near>0.05</near>
              <far>4.0</far>
            </clip>
          </depth_camera>
        </camera>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>/ventek/vision/camera</topic>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>
