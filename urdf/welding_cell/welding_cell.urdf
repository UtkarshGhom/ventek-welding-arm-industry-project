    <inertial>
      <mass value="3.0"/>
      <origin rpy="0 0 0" xyz="0.02 0.0 0.0"/>
      <inertia ixx="0.015" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.02"/>
    </inertial>
  </link>
  <joint name="joint_a5" type="revolute">
    <origin rpy="0 0 0" xyz="0.420 0 0"/>
    <parent link="link_4"/>
    <child link="link_5"/>
    <axis xyz="0 1 0"/>
    <limit effort="40" lower="-2.0943951023931953" upper="2.0943951023931953" velocity="6.771877497737998"/>
    <dynamics damping="3.0" friction="0.4"/>
  </joint>
  <!-- LINK 6 -->
  <link name="link_6">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://ventek_autonomous_welding/simulation/robot/meshes/visual/link_6.dae"/>
      </geometry>
      <material name="kuka_pedestal_dark"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://ventek_autonomous_welding/simulation/robot/meshes/collision/link_6.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <origin rpy="0 0 0" xyz="0.01 0.0 0.0"/>
      <inertia ixx="0.005" ixy="0.0" ixz="0.0" iyy="0.005" iyz="0.0" izz="0.005"/>
    </inertial>
  </link>
  <joint name="joint_a6" type="revolute">
    <origin rpy="0 0 0" xyz="0.080 0 0"/>
    <parent link="link_5"/>
    <child link="link_6"/>
    <axis xyz="-1 0 0"/>
    <limit effort="20" lower="-6.1086523819801535" upper="6.1086523819801535" velocity="10.733774899765127"/>
    <dynamics damping="1.0" friction="0.2"/>
  </joint>
  <!-- FLANGE (REP-199 standard attachment) -->
  <link name="flange"/>
  <joint name="joint_a6_flange" type="fixed">
    <parent link="link_6"/>
    <child link="flange"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <!-- TOOL0 (Standard KUKA $TOOL frame rotated by 90 deg around Y) -->
  <link name="tool0"/>
  <joint name="flange_tool0" type="fixed">
    <parent link="flange"/>
    <child link="tool0"/>
    <origin rpy="0 1.5707963267948966 0" xyz="0 0 0"/>
  </joint>
  <transmission name="joint_a1_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="joint_a1">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="joint_a1_motor">
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="joint_a2_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="joint_a2">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="joint_a2_motor">
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="joint_a3_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="joint_a3">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="joint_a3_motor">
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="joint_a4_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="joint_a4">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="joint_a4_motor">
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="joint_a5_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="joint_a5">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="joint_a5_motor">
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="joint_a6_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="joint_a6">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="joint_a6_motor">
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <!-- Gazebo Sim Joint Position Controllers for Interactive Slider Control -->
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint_a1</joint_name>
      <topic>/model/ventek_welding_cell/joint/joint_a1/cmd_pos</topic>
      <p_gain>12000.0</p_gain>
      <i_gain>10.0</i_gain>
      <d_gain>250.0</d_gain>
      <i_max>50.0</i_max>
      <i_min>-50.0</i_min>
      <cmd_max>300.0</cmd_max>
      <cmd_min>-300.0</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint_a2</joint_name>
      <topic>/model/ventek_welding_cell/joint/joint_a2/cmd_pos</topic>
      <p_gain>18000.0</p_gain>
      <i_gain>20.0</i_gain>
      <d_gain>350.0</d_gain>
      <i_max>100.0</i_max>
      <i_min>-100.0</i_min>
      <cmd_max>400.0</cmd_max>
      <cmd_min>-400.0</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint_a3</joint_name>
      <topic>/model/ventek_welding_cell/joint/joint_a3/cmd_pos</topic>
      <p_gain>12000.0</p_gain>
      <i_gain>10.0</i_gain>
      <d_gain>250.0</d_gain>
      <i_max>50.0</i_max>
      <i_min>-50.0</i_min>
      <cmd_max>300.0</cmd_max>
      <cmd_min>-300.0</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint_a4</joint_name>
      <topic>/model/ventek_welding_cell/joint/joint_a4/cmd_pos</topic>
      <p_gain>4000.0</p_gain>
      <i_gain>5.0</i_gain>
      <d_gain>80.0</d_gain>
      <i_max>20.0</i_max>
      <i_min>-20.0</i_min>
      <cmd_max>150.0</cmd_max>
      <cmd_min>-150.0</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint_a5</joint_name>
      <topic>/model/ventek_welding_cell/joint/joint_a5/cmd_pos</topic>
      <p_gain>4000.0</p_gain>
      <i_gain>5.0</i_gain>
      <d_gain>80.0</d_gain>
      <i_max>20.0</i_max>
      <i_min>-20.0</i_min>
      <cmd_max>150.0</cmd_max>
      <cmd_min>-150.0</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint_a6</joint_name>
      <topic>/model/ventek_welding_cell/joint/joint_a6/cmd_pos</topic>
      <p_gain>2000.0</p_gain>
      <i_gain>2.0</i_gain>
      <d_gain>30.0</d_gain>
      <i_max>10.0</i_max>
      <i_min>-10.0</i_min>
      <cmd_max>100.0</cmd_max>
      <cmd_min>-100.0</cmd_min>
    </plugin>
  </gazebo>
  <joint name="welding_torch_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="tool0"/>
    <child link="welding_torch_link"/>
  </joint>
  <link name="welding_torch_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://ventek_autonomous_welding/simulation/tool/meshes/welding_torch.dae"/>
      </geometry>
      <material name="torch_brass">
        <color rgba="0.88 0.55 0.18 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://ventek_autonomous_welding/simulation/tool/meshes/welding_torch.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.2"/>
      <origin rpy="0 0 0" xyz="0.04 0.0 0.12"/>
      <inertia ixx="0.015" ixy="0.0" ixz="0.0" iyy="0.018" iyz="0.0" izz="0.008"/>
    </inertial>
  </link>
  <!-- Gazebo Shading Material for Welding Torch -->
  <gazebo reference="welding_torch_link">
    <visual>
      <material>
        <ambient>0.60 0.35 0.10 1.0</ambient>
        <diffuse>0.88 0.55 0.18 1.0</diffuse>
        <specular>0.70 0.55 0.30 1.0</specular>
      </material>
    </visual>
  </gazebo>
  <!-- Tool Centre Point (TCP) Definition -->
  <!-- Matches system_config.yaml (welding_torch_tip) -->
  <link name="welding_torch_tip"/>
  <joint name="welding_torch_tip_joint" type="fixed">
    <origin rpy="0 0.785398 0" xyz="0.1344 0.0 0.2574"/>
    <parent link="welding_torch_link"/>
    <child link="welding_torch_tip"/>
  </joint>
  <!-- Alias matching simulation plan (tcp_welding_torch) -->
  <link name="tcp_welding_torch"/>
  <joint name="tcp_welding_torch_alias" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="welding_torch_tip"/>
    <child link="tcp_welding_torch"/>
  </joint>
  <!-- ======================================================================== -->
  <!-- Eye-in-Hand OAK-D Lite Depth Camera (Mounted on Welding Torch / Arm)     -->
  <!-- POV directly tracks the welding torch tip and joint seam in real time   -->
  <!-- ======================================================================== -->
  <link name="camera_link">
    <visual>
      <!-- Rotate -90 deg around Z so the 3D model lenses (+Y) point along camera optical axis (+X) -->
      <origin rpy="0 0 -1.570796" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://ventek_autonomous_welding/simulation/cell/meshes/camera_oak_d_lite.dae"/>
      </geometry>
      <material name="camera_anodized_black">
        <color rgba="0.10 0.10 0.12 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.030 0.095 0.030"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <!-- Camera mounted on torch bracket: elevated above torch neck, looking at weld seam & nozzle -->
  <joint name="camera_joint" type="fixed">
    <origin rpy="0 0.82 0" xyz="-0.04 0.0 0.14"/>
    <parent link="welding_torch_link"/>
    <child link="camera_link"/>
  </joint>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <origin rpy="-1.570796 0 -1.570796" xyz="0 0 0"/>
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
  </joint>
  <!-- Alias matching simulation plan (camera_frame) -->
  <link name="camera_frame"/>
  <joint name="camera_frame_alias" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="camera_link"/>
    <child link="camera_frame"/>
  </joint>
  <!-- Alias matching Gazebo Sim frame_ids for seamless RViz PointCloud2 & Camera displays -->
  <link name="oak_d_lite_sensor_model/camera_sensor_link/oak_d_lite_camera"/>
  <joint name="gz_sensor_frame_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="camera_link"/>
    <child link="oak_d_lite_sensor_model/camera_sensor_link/oak_d_lite_camera"/>
  </joint>
  <link name="ventek_welding_cell/camera_link/oak_d_lite_camera"/>
  <joint name="gz_sensor_cell_frame_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="camera_link"/>
    <child link="ventek_welding_cell/camera_link/oak_d_lite_camera"/>
  </joint>
  <!-- Gazebo Shading & Moving Eye-in-Hand RGB-D Camera Sensor -->
  <gazebo reference="camera_link">
    <visual>
      <material>
        <ambient>0.06 0.06 0.08 1.0</ambient>
        <diffuse>0.10 0.10 0.12 1.0</diffuse>
        <specular>0.20 0.20 0.20 1.0</specular>
      </material>
    </visual>
    <sensor name="oak_d_lite_camera" type="rgbd_camera">
      <camera>
        <horizontal_fov>1.204</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>4.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.05</near>
            <far>4.0</far>
          </clip>
        </depth_camera>
      </camera>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>/ventek/vision/camera</topic>
    </sensor>
  </gazebo>
  <!-- ======================================================================== -->
  <!-- Gazebo Material Colors for Visual Realism                                -->
  <!-- ======================================================================== -->
  <gazebo reference="base_link">
    <visual>
      <material>
        <ambient>0.2 0.2 0.2 1.0</ambient>
        <diffuse>0.2 0.2 0.2 1.0</diffuse>
      </material>
    </visual>
  </gazebo>
  <gazebo reference="link_1">
    <visual>
      <material>
        <ambient>0.96 0.33 0.08 1.0</ambient>
        <diffuse>0.96 0.33 0.08 1.0</diffuse>
